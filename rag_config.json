{
  "source_paths": [
    "~/Documents",
    "~/Desktop"
  ],
  "exclude_paths": [
    "~/.Trash",
    "/System",
    "/Library",
    "/Applications"
  ],
  "database_path": "./rag_index.sqlite3",
  "chunk_size": 1200,
  "chunk_overlap": 180,
  "max_files": 0,
  "ollama_model": "llama3.1:8b",
  "top_k": 6,
  "allowed_extensions": [
    ".txt", ".md", ".csv", ".json", ".jsonl", ".xml", ".html", ".htm",
    ".pdf", ".docx", ".pptx", ".xlsx", ".xls", ".py", ".js", ".ts", ".java", ".go", ".rs", ".sql", ".log"
  ]
}
