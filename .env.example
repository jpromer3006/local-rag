# Local LLM (Ollama)
OLLAMA_MODEL=llama3.1:8b

# Optional: Claude for "deep" mode answers
ANTHROPIC_API_KEY=

# Optional: ElevenLabs for text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Document directories (comma-separated)
RAG_DOCS_DIR=~/Documents,~/Desktop

# Default query mode: "fast" (Ollama) or "deep" (Claude)
DEFAULT_MODE=fast
